#!/bin/sh
set -eu

DATABASE_PATH=${DATABASE_PATH:-/var/lib/raid-website/raid.db}
BACKUP_DIR=${BACKUP_DIR:-/var/backups/raid-website}
LOCK_FILE=/run/raid-website-backup.lock

umask 077
mkdir -p "$BACKUP_DIR"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "another Raid Website backup is already running"
    exit 0
fi

verify_snapshot() {
    snapshot=$(find "$BACKUP_DIR" -maxdepth 1 -type f -name 'raid.db-*.sqlite3.gz' -printf '%f\n' | sort | tail -n 1)
    if [ -z "${snapshot:-}" ]; then
        echo "no database snapshot exists" >&2
        exit 1
    fi

    checksum="$BACKUP_DIR/$snapshot.sha256"
    if [ ! -f "$checksum" ]; then
        echo "missing checksum for $snapshot" >&2
        exit 1
    fi

    (cd "$BACKUP_DIR" && sha256sum -c "$(basename "$checksum")")
    temporary_database=$(mktemp "$BACKUP_DIR/.verify.XXXXXX.sqlite3")
    trap 'rm -f "$temporary_database"' EXIT HUP INT TERM
    gzip -cd "$BACKUP_DIR/$snapshot" >"$temporary_database"
    python3 - "$temporary_database" <<'PY'
import sqlite3
import sys

connection = sqlite3.connect(sys.argv[1])
try:
    result = connection.execute("PRAGMA integrity_check").fetchone()[0]
finally:
    connection.close()
if result != "ok":
    raise SystemExit("SQLite integrity_check failed: " + result)
PY
    rm -f "$temporary_database"
    trap - EXIT HUP INT TERM
    echo "verified $snapshot"
}

# Off-server copy (NFR-2.3, SC-034). The settings file holds no secrets; the
# SSH key, known_hosts, and gpg passphrase live root-only in $OFFSITE_KEY_DIR.
load_offsite_settings() {
    OFFSITE_SETTINGS=${OFFSITE_SETTINGS:-/etc/raid-website-backup.env}
    if [ ! -r "$OFFSITE_SETTINGS" ]; then
        echo "missing off-server settings: $OFFSITE_SETTINGS" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    . "$OFFSITE_SETTINGS"
    : "${OFFSITE_HOST:?OFFSITE_HOST is not set}"
    : "${OFFSITE_USER:?OFFSITE_USER is not set}"
    OFFSITE_PORT=${OFFSITE_PORT:-23}
    OFFSITE_KEY_DIR=${OFFSITE_KEY_DIR:-/etc/raid-website-backup}
    APP_ENV_FILE=${APP_ENV_FILE:-/etc/raid-website.env}
    for required in id_ed25519 known_hosts passphrase; do
        if [ ! -s "$OFFSITE_KEY_DIR/$required" ]; then
            echo "missing $OFFSITE_KEY_DIR/$required" >&2
            exit 1
        fi
    done
}

# Runs one sftp batch read from stdin; any failed command fails the call.
offsite_sftp() {
    sftp -q -b - -F /dev/null -P "$OFFSITE_PORT" \
        -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
        -o "IdentityFile=$OFFSITE_KEY_DIR/id_ed25519" \
        -o "UserKnownHostsFile=$OFFSITE_KEY_DIR/known_hosts" \
        -o ConnectTimeout=30 -o ServerAliveInterval=15 \
        "$OFFSITE_USER@$OFFSITE_HOST"
}

offsite_gpg() {
    gpg --homedir "$work/gnupg" --batch --yes --quiet --no-tty --pinentry-mode loopback \
        --passphrase-file "$OFFSITE_KEY_DIR/passphrase" "$@"
}

cleanup_work() {
    if [ -n "${server_pid:-}" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    gpgconf --homedir "$work/gnupg" --kill all >/dev/null 2>&1 || true
    rm -rf "$work"
}

offsite_archives() {
    listing=$(printf 'ls -1\n' | offsite_sftp)
    printf '%s\n' "$listing" | sed -n 's|^\(\./\)\{0,1\}\(raid-website-[0-9]\{8\}T[0-9]\{6\}Z\.tar\.gpg\)$|\2|p' | sort
}

offsite_upload() {
    load_offsite_settings
    verify_snapshot
    snapshot=$(find "$BACKUP_DIR" -maxdepth 1 -type f -name 'raid.db-*.sqlite3.gz' -printf '%f\n' | sort | tail -n 1)
    stamp=${snapshot#raid.db-}
    stamp=${stamp%.sqlite3.gz}
    archive="raid-website-$stamp.tar.gpg"

    # The server only adds files and never deletes or replaces one, so a copy
    # that left the host stays as it was; Storage Box snapshots cover the rest.
    archives=$(offsite_archives)
    if printf '%s\n' "$archives" | grep -qx "$archive"; then
        echo "$archive is already off the server"
        return 0
    fi

    work=$(mktemp -d)
    trap cleanup_work EXIT HUP INT TERM
    mkdir -m 0700 "$work/gnupg" "$work/bundle"
    cp "$BACKUP_DIR/$snapshot" "$BACKUP_DIR/$snapshot.sha256" "$work/bundle/"
    cp "$APP_ENV_FILE" "$work/bundle/raid-website.env"
    tar -C "$work/bundle" -cf "$work/bundle.tar" .
    offsite_gpg --symmetric --cipher-algo AES256 --s2k-digest-algo SHA512 \
        --s2k-count 65011712 --compress-algo none -o "$work/$archive" "$work/bundle.tar"
    (cd "$work" && sha256sum "$archive" >"$archive.sha256")

    offsite_sftp <<EOF
put $work/$archive.sha256 .upload-$archive.sha256
put $work/$archive .upload-$archive
rename .upload-$archive.sha256 $archive.sha256
rename .upload-$archive $archive
get $archive $work/downloaded
EOF
    if ! cmp -s "$work/$archive" "$work/downloaded"; then
        echo "uploaded $archive does not match the local copy" >&2
        exit 1
    fi
    echo "copied $archive off the server"
}

# Monthly restore test (NFR-2.5): fetch the newest off-server copy, decrypt it,
# check it, and start the installed server binary on a throwaway copy.
offsite_restore_test() {
    load_offsite_settings
    archive=$(offsite_archives | tail -n 1)
    if [ -z "${archive:-}" ]; then
        echo "no off-server copy exists" >&2
        exit 1
    fi

    work=$(mktemp -d)
    server_pid=
    trap cleanup_work EXIT HUP INT TERM
    mkdir -m 0700 "$work/gnupg" "$work/bundle"
    offsite_sftp <<EOF
get $archive $work/$archive
get $archive.sha256 $work/$archive.sha256
EOF
    (cd "$work" && sha256sum -c "$archive.sha256")
    offsite_gpg -d -o "$work/bundle.tar" "$work/$archive"
    tar -C "$work/bundle" -xf "$work/bundle.tar"
    snapshot=$(find "$work/bundle" -maxdepth 1 -type f -name 'raid.db-*.sqlite3.gz' -printf '%f\n' | head -n 1)
    if [ -z "${snapshot:-}" ] || [ ! -s "$work/bundle/raid-website.env" ]; then
        echo "$archive lacks the database snapshot or the environment file" >&2
        exit 1
    fi
    (cd "$work/bundle" && sha256sum -c "$snapshot.sha256")

    restore_dir="$work/restore"
    mkdir "$restore_dir"
    gzip -cd "$work/bundle/$snapshot" >"$restore_dir/raid.db"
    python3 - "$restore_dir/raid.db" <<'PY'
import sqlite3
import sys

connection = sqlite3.connect(sys.argv[1])
try:
    result = connection.execute("PRAGMA integrity_check").fetchone()[0]
    if result != "ok":
        raise SystemExit("SQLite integrity_check failed: " + result)
    players = connection.execute("SELECT COUNT(*) FROM players").fetchone()[0]
    raids = connection.execute("SELECT COUNT(*) FROM raids").fetchone()[0]
finally:
    connection.close()
if players == 0 or raids == 0:
    raise SystemExit("restored database has no players or raids")
print(f"restored database: {players} players, {raids} raids")
PY

    # Only archived TOTP keys accompany the isolated copy. Never source the
    # environment as shell code or enable production integrations during a test.
    chown -R raidweb:raidweb "$restore_dir"
    chmod 0711 "$work"
    (cd "$restore_dir" && exec python3 - "$work/bundle/raid-website.env" "$restore_dir" "$SERVER_BINARY" <<'RESTORE_PY'
import base64
import os
import shlex
import sys


def restore_environment(env_file, restore_dir):
    environment = {
        "PATH": "/usr/bin:/bin",
        "ENV": "development",
        "LISTEN_ADDR": "127.0.0.1:18080",
        "DATABASE_URL": f"file:{restore_dir}/raid.db?_pragma=journal_mode(WAL)",
    }
    allowed = {"TOTP_ENCRYPTION_KEY", "TOTP_ENCRYPTION_KEYS_PREVIOUS"}
    with open(env_file, encoding="utf-8") as source:
        for line in source:
            name, separator, raw = line.strip().partition("=")
            if not separator or name not in allowed:
                continue
            try:
                fields = shlex.split(raw, comments=False)
                if len(fields) > 1:
                    raise ValueError("multiple values")
                value = fields[0] if fields else ""
                keys = value.split(",") if name.endswith("_PREVIOUS") else [value]
                if value and any(len(base64.b64decode(key.strip(), validate=True)) != 32 for key in keys):
                    raise ValueError("invalid key length")
            except ValueError:
                raise SystemExit("invalid archived " + name) from None
            environment[name] = value
    return environment


if __name__ == "__main__":
    environment = restore_environment(sys.argv[1], sys.argv[2])
    os.execve("/usr/bin/setpriv", ["setpriv", "--reuid=raidweb", "--regid=raidweb",
              "--clear-groups", "--no-new-privs", sys.argv[3]], environment)
RESTORE_PY
    ) >"$work/server.log" 2>&1 &
    server_pid=$!
    healthy=false
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if curl --fail --silent --max-time 2 http://127.0.0.1:18080/api/v1/health >/dev/null; then
            healthy=true
            break
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    if [ "$healthy" != true ]; then
        echo "the server did not start with the restored copy of $archive" >&2
        tail -n 20 "$work/server.log" >&2
        exit 1
    fi
    curl --fail --silent --max-time 5 http://127.0.0.1:18080/api/v1/statistics >/dev/null
    echo "restore test passed for $archive"
}

if [ "${1:-}" = "--verify" ]; then
    verify_snapshot
    exit 0
fi
if [ "${1:-}" = "--offsite" ]; then
    offsite_upload
    exit 0
fi
if [ "${1:-}" = "--restore-test" ]; then
    SERVER_BINARY=${SERVER_BINARY:-/opt/raid-website/server}
    offsite_restore_test
    exit 0
fi
if [ "$#" -ne 0 ]; then
    echo "usage: $0 [--verify | --offsite | --restore-test]" >&2
    exit 2
fi

if [ ! -f "$DATABASE_PATH" ]; then
    echo "database does not exist: $DATABASE_PATH" >&2
    exit 1
fi

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
snapshot="raid.db-$timestamp.sqlite3.gz"
temporary_database=$(mktemp "$BACKUP_DIR/.snapshot.XXXXXX.sqlite3")
temporary_snapshot=$(mktemp "$BACKUP_DIR/.snapshot.XXXXXX.gz")
trap 'rm -f "$temporary_database" "$temporary_snapshot"' EXIT HUP INT TERM

# sqlite3.Connection.backup reads a transactionally consistent view, including WAL data.
python3 - "$DATABASE_PATH" "$temporary_database" <<'PY'
import os
import sqlite3
import sys

source_path, destination_path = sys.argv[1:]
source = sqlite3.connect("file:" + source_path + "?mode=ro", uri=True)
destination = sqlite3.connect(destination_path)
try:
    source.backup(destination)
    result = destination.execute("PRAGMA integrity_check").fetchone()[0]
    if result != "ok":
        raise RuntimeError("SQLite integrity_check failed: " + result)
finally:
    destination.close()
    source.close()
os.chmod(destination_path, 0o600)
PY

gzip -9 -c "$temporary_database" >"$temporary_snapshot"
mv -f "$temporary_snapshot" "$BACKUP_DIR/$snapshot"
(cd "$BACKUP_DIR" && sha256sum "$snapshot" >"$snapshot.sha256")
rm -f "$temporary_database"
trap - EXIT HUP INT TERM

# Keep 48 hourly, 32 daily, 13 weekly, and 25 monthly recovery points.
python3 - "$BACKUP_DIR" <<'PY'
from datetime import datetime, timezone
from pathlib import Path
import re
import sys

directory = Path(sys.argv[1])
pattern = re.compile(r"raid\.db-(\d{8}T\d{6}Z)\.sqlite3\.gz$")
now = datetime.now(timezone.utc)
snapshots = []
for path in directory.glob("raid.db-*.sqlite3.gz"):
    match = pattern.fullmatch(path.name)
    if match:
        snapshots.append((datetime.strptime(match.group(1), "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc), path))

keep = set()
daily = set()
weekly = set()
monthly = set()
for captured_at, path in sorted(snapshots, reverse=True):
    age_hours = (now - captured_at).total_seconds() / 3600
    if age_hours <= 48:
        keep.add(path)
    day = captured_at.date()
    week = captured_at.isocalendar()[:2]
    month = (captured_at.year, captured_at.month)
    if age_hours <= 32 * 24 and day not in daily:
        daily.add(day)
        keep.add(path)
    if age_hours <= 13 * 7 * 24 and week not in weekly:
        weekly.add(week)
        keep.add(path)
    if age_hours <= 25 * 31 * 24 and month not in monthly:
        monthly.add(month)
        keep.add(path)

for _, path in snapshots:
    if path not in keep:
        path.unlink()
        checksum = path.with_name(path.name + ".sha256")
        if checksum.exists():
            checksum.unlink()
PY

echo "created and verified $BACKUP_DIR/$snapshot"
