#!/bin/sh
set -eu

APP_DIR=/opt/raid-website
BINARY_PATH=$APP_DIR/build/server.new
REVISION_PATH=$APP_DIR/build/revision
CURRENT_BINARY=$APP_DIR/server
PREVIOUS_BINARY=$APP_DIR/server.previous
REVISION_FILE=$APP_DIR/current-revision
HEALTH_URL=http://127.0.0.1:8080/api/v1/health
LOCK_FILE=/run/raid-website-publish.lock

if [ "$#" -ne 0 ]; then
    echo "usage: $0" >&2
    exit 2
fi
if [ ! -f "$REVISION_PATH" ] || [ -L "$REVISION_PATH" ]; then
    echo "built revision is missing or is a symbolic link" >&2
    exit 1
fi
revision=$(cat "$REVISION_PATH")
if [ "${#revision}" -ne 40 ]; then
    echo "invalid Git revision" >&2
    exit 2
fi
case "$revision" in
    *[!0123456789abcdef]*) echo "invalid Git revision" >&2; exit 2 ;;
esac
if [ ! -f "$BINARY_PATH" ] || [ -L "$BINARY_PATH" ]; then
    echo "built binary is missing or is a symbolic link" >&2
    exit 1
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "another Raid Website publish is already running"
    exit 0
fi

systemctl start raid-website-backup.service
cp -a "$CURRENT_BINARY" "$PREVIOUS_BINARY"
install -o root -g root -m 0755 "$BINARY_PATH" "$CURRENT_BINARY.new"
mv -f "$CURRENT_BINARY.new" "$CURRENT_BINARY"
systemctl restart raid-website.service
healthy=false
attempt=0
while [ "$attempt" -lt 15 ]; do
    if curl --fail --silent --max-time 2 "$HEALTH_URL" >/dev/null; then
        healthy=true
        break
    fi
    attempt=$((attempt + 1))
    sleep 2
done
if [ "$healthy" != true ]; then
    echo "published revision failed its health check; restoring previous binary" >&2
    install -o root -g root -m 0755 "$PREVIOUS_BINARY" "$CURRENT_BINARY"
    systemctl restart raid-website.service
    exit 1
fi
printf '%s\n' "$revision" >"$REVISION_FILE"
echo "published $revision"
